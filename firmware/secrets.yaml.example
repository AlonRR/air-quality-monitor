# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and must stay so:
# it holds the only copies of these values that exist in this repo.
#
# Every entry here was moved OUT of tracked source deliberately. A value that is
# only removed at publish time depends on a filter running correctly every time;
# a value that was never committed cannot leak from a clone, a mirror, or history.

wifi_ssid: "YOUR_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ap_password: "YOUR_FALLBACK_AP_PASSWORD"
ota_password: "YOUR_OTA_PASSWORD"

# MQTT. These were referenced by four configs in the 3D-printing toolkit this
# repository was split from - print-chamber among them - while being absent from this
# file, so `esphome config` failed on a FRESH CLONE with "Secret 'mqtt_host' not
# defined" even though every one of them is valid here. The working machine has
# them in its own secrets.yaml, which is exactly why the gap stayed invisible:
# nothing on a developed checkout ever exercises the example file.
#
# mqtt_host is the broker address. Use a hostname or an address that means
# something on YOUR network - the real value is deliberately not in this repo.
mqtt_host: "mqtt.example.invalid"
mqtt_username: "YOUR_MQTT_USERNAME"
mqtt_esp_password: "YOUR_MQTT_PASSWORD_FOR_ESP_NODES"
